<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    CactusReaderServer：WCF (WebServiceHost) -> ASP.NET Core Minimal API 迁移（2026-08）
    协议与旧版完全一致（URL/Header/Content-Type），客户端零改动。
    端口：http://127.0.0.1:9527
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CactusReaderService</RootNamespace>
    <AssemblyName>CactusReaderServer</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <SignAssembly>False</SignAssembly>
    <DelaySign>False</DelaySign>
    <!-- 本地开发凭据（数据库密码 / Graph 密钥）存储于用户目录，不入库 -->
    <UserSecretsId>cactus-reader-server</UserSecretsId>
  </PropertyGroup>

  <!--
    2026-08：服务端承担数据库访问（客户端不再直连 MySQL）与验证码邮件发送（SMTP 凭据不再进客户端）。
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="FreeSql" Version="3.5.311" />
    <PackageReference Include="FreeSql.Provider.MySql" Version="3.5.311" />
    <PackageReference Include="Microsoft.Graph" Version="6.5.0" />
  </ItemGroup>

</Project>
