<Project Sdk="Microsoft.NET.Sdk">

  <!--
    现代 .NET UWP 项目（.NET Native -> 现代 .NET 迁移，2026-08）
    参考：https://learn.microsoft.com/zh-cn/windows/uwp/dotnet-native/modernize-uwp-apps-with-dotnet
    策略：SelfContained 自包含发布（保留 FreeSql / Newtonsoft.Json 等反射库，暂不启用 Native AOT）
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <!-- Release 自包含发布（包内携带 .NET 运行时），Debug 使用框架依赖 -->
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>

    <RootNamespace>Cactus_Reader</RootNamespace>
    <AssemblyName>Cactus Reader</AssemblyName>
    <DefaultLanguage>zh-cn</DefaultLanguage>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <!-- WebClient 仍可用（SYSLIB0014 过时警告），SelfContained 下行为不变，暂不迁移 HttpClient -->
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>

    <!-- 程序集元数据（原 Properties\AssemblyInfo.cs 映射至此） -->
    <AssemblyTitle>Cactus Reader</AssemblyTitle>
    <Description>Cactus Reader，一款现代化的、高效的文档阅读器。</Description>
    <Company>R.S.Software Studio</Company>
    <Product>Cactus Reader</Product>
    <Copyright>Copyright © 2022-2025, Robert Chen.</Copyright>
    <AssemblyTrademark>Cactus Reader</AssemblyTrademark>
    <AssemblyVersion>1.1.0.1</AssemblyVersion>
    <FileVersion>1.1.0.1</FileVersion>

    <!-- MSIX 打包签名（保留原证书） -->
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>3488B004AE9E20A5B5A033540B3D9B1A27313624</PackageCertificateThumbprint>
    <AppxBundle>Never</AppxBundle>
    <SignAssembly>False</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet 依赖（已升级至 2026-08 最新稳定版）
         2026-08：移除 FreeSql / FreeSql.Provider.MySql / MailKit ——
         客户端不再直连 MySQL（数据库操作迁至 CactusReaderServer API），
         不再发送 SMTP 邮件（发信逻辑移至服务端）。 -->
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.51.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Microsoft.Xml.SgmlReader" Version="1.8.30" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- 显式统一 System.Drawing.Common 版本：消除 NU1904 安全漏洞(4.7.0) 与 MSB3277 版本冲突 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.30" />
  </ItemGroup>

  <!-- 字体资源（保持 Content 语义，XAML 中通过 ms-appx:/// 引用） -->
  <ItemGroup>
    <Content Include="Sources\Fonts\Segoe Fluent Icons.ttf" />
    <Content Include="Sources\Fonts\MiSans\**\*" />
    <Content Include="Sources\Fonts\JetBrainsMono\**\*" />
  </ItemGroup>

  <!-- 页面静态图片资源（迁移现代 .NET UWP 后默认不再自动打包，需显式声明） -->
  <ItemGroup>
    <Content Include="Sources\Images\**\*" />
  </ItemGroup>

  <!-- 随包复制到输出目录的文档 -->
  <ItemGroup>
    <None Include="Assets\服务协议.rtf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\隐私政策.rtf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
