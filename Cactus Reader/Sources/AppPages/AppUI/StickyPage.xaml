<Page
    x:Class="Cactus_Reader.Sources.AppPages.AppUI.StickyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cactus_Reader.Sources.AppPages.AppUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Page.Resources>
        <FontFamily x:Key="MiSans">/Sources/Fonts/MiSans/MiSans-Regular.ttf#MiSans</FontFamily>
        <FontFamily x:Key="MiSansBold">/Sources/Fonts/MiSans/MiSans-Bold.ttf#MiSans Bold</FontFamily>
        <FontFamily x:Key="SegoeFluentIcons">/Sources/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons</FontFamily>

        <!-- 基于系统默认 GridViewItem 样式：内容横向撑满 ItemsWrapGrid 分配的列宽，
             多选勾选/选中高亮等视觉全部沿用系统默认（Win11 规范） -->
        <Style x:Key="StickyGridViewItemStyle" TargetType="GridViewItem"
               BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <StackPanel Canvas.ZIndex="1" Orientation="Vertical" HorizontalAlignment="Stretch"
                    Height="auto" VerticalAlignment="Top" Padding="24, 24, 24, 12"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="便签本" FontSize="26" FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                <CommandBar Grid.Column="1" Background="Transparent" IsOpen="False"
                            DefaultLabelPosition="Right">
                    <AppBarButton Label="新建便签" Click="CreateNewSticky">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE932;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="MultiSelectButton" Label="选择便签" Click="ToggleMultiSelectMode">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE762;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="切换视图">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8B3;"/>
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Tag="1" Text="单列视图" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="2" Text="双列视图" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="3" Text="三列视图" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="4" Text="四列视图" Click="ChangeViewColumns"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>
            </Grid>
            <AutoSuggestBox Height="36" PlaceholderText="搜索便签本 ......" VerticalContentAlignment="Center"
                            Margin="0, 8, 0, 0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="auto" Padding="16, 0, 16, 0">
            <Grid Padding="0, 0, 0, 16">
                <Grid x:Name="EmptyPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                      x:FieldModifier="Public" Padding="0, 128, 0, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Sources/Images/NotesEmpty.png" Stretch="Uniform"
                               VerticalAlignment="Center" MaxWidth="300" Grid.Column="0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="40, 0, 0, 0" Grid.Column="1">
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="这里空空如也，什么也没有。"
                                       TextWrapping="Wrap"/>
                        <TextBlock Margin="0, 8, 0, 0" Foreground="#9A9A9A" TextWrapping="Wrap"
                                       Text="使用 Cactus Note 创建阅读计划，或者记下读书灵感。"/>
                    </StackPanel>
                </Grid>
                <GridView x:Name="StickyQuickViewList" x:FieldModifier="Public" Background="Transparent"
                          Padding="0, 128, 0, 0" SelectionMode="None" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource StickyGridViewItemStyle}"
                          SelectionChanged="StickyQuickViewList_SelectionChanged"
                          SizeChanged="StickyQuickViewList_SizeChanged">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 间距由 ItemsWrapGrid 的 Margin 承担（左右 8），行间 8px 由下方 margin 留白 -->
                            <ItemsWrapGrid Orientation="Horizontal" Margin="8, 0, 8, 8"
                                           HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>
        </ScrollViewer>
        <!-- 多选模式删除按钮：右下角悬浮（Accent 强调色），仅多选且有选中项时显示 -->
        <Button x:Name="DeleteSelectedButton" Click="DeleteSelectedSticky"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0, 0, 16, 16" Padding="18, 10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE74D;" FontSize="16"/>
                <TextBlock Text="删除" FontSize="14"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>
