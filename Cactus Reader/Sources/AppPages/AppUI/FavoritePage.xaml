<Page
    x:Class="Cactus_Reader.Sources.AppPages.AppUI.FavoritePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cactus_Reader.Sources.ToolKits"
    xmlns:appui="using:Cactus_Reader.Sources.AppPages.AppUI"
    xmlns:entities="using:Cactus_Reader.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Page.Resources>
        <FontFamily x:Key="SegoeFluentIcons">/Sources/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons</FontFamily>

        <!-- 基于系统默认 GridViewItem 样式：内容横向撑满 ItemsWrapGrid 分配的列宽，
             多选勾选/选中高亮等视觉全部沿用系统默认（Win11 规范） -->
        <Style x:Key="FavoriteGridViewItemStyle" TargetType="GridViewItem"
               BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 阅读记录收藏卡片：矩形封面（类型图标）+ 金色星标 + 书名 + 类型标签 + 最后阅读时间；
             右键菜单：打开 / 分享 / 取消收藏 / 删除（进回收站） -->
        <DataTemplate x:Key="FavoriteReadingTemplate" x:DataType="entities:ReadingItem">
            <Grid Margin="8" RightTapped="FavoriteCardRightTapped">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="打开" Click="OpenFavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8E5;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="分享" Click="ShareFavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE72D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="取消收藏" Click="UnfavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE734;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="删除" Click="DeleteFavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE74D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <!-- 封面缩略图：统一使用矩形色块 + 类型图标替代（固定高度，随列宽横向拉伸） -->
                <Border Grid.Row="0" Height="168" HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" CornerRadius="8"
                        Background="{x:Bind local:ReadingItemVisual.GetCoverBrush(ItemType)}">
                    <Grid>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}"
                                  Glyph="{x:Bind local:ReadingItemVisual.GetGlyph(ItemType)}"
                                  Foreground="White" FontSize="30"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="#40FFFFFF" CornerRadius="6" Padding="6, 2" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind local:ReadingItemVisual.GetTypeText(ItemType)}"
                                       FontSize="10" Foreground="White"/>
                        </Border>
                        <!-- 已收藏角标：金色星标 -->
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE735;"
                                  Foreground="#FFC83D" FontSize="18"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           Margin="4, 8, 4, 0"/>
                <TextBlock Grid.Row="2"
                           Text="{x:Bind local:ReadingItemVisual.FormatTime(UpdateTime)}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="4, 4, 4, 0"/>
            </Grid>
        </DataTemplate>

        <!-- 便签收藏卡片：主题色封面（浅色纸条风）+ 金色星标 + 第一行内容标题 + 内容预览 + 修改时间；
             右键菜单：打开 / 分享 / 取消收藏 / 删除（进回收站） -->
        <DataTemplate x:Key="FavoriteStickyTemplate" x:DataType="entities:Sticky">
            <Grid Margin="8" RightTapped="FavoriteCardRightTapped">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="打开" Click="OpenFavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE890;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="分享" Click="ShareFavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE72D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="取消收藏" Click="UnfavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE734;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="删除" Click="DeleteFavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE74D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <!-- 便签封面：主题浅色底 + 深色便签图标 + 金色星标 -->
                <Border Grid.Row="0" Height="168" HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" CornerRadius="8"
                        Background="{x:Bind local:ReadingItemVisual.GetStickyCoverBrush(StickyTheme)}">
                    <Grid>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}"
                                  Glyph="{x:Bind local:ReadingItemVisual.GetGlyph(ItemType)}"
                                  Foreground="#8C000000" FontSize="30"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="#22000000" CornerRadius="6" Padding="6, 2" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind local:ReadingItemVisual.GetTypeText(ItemType)}"
                                       FontSize="10" Foreground="#99000000"/>
                        </Border>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE735;"
                                  Foreground="#E8A800" FontSize="18"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1"
                           Text="{x:Bind local:ReadingItemVisual.GetStickyTitleText(QuickViewText, IsLock)}"
                           FontSize="14" FontWeight="SemiBold"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           Margin="4, 8, 4, 0"/>
                <TextBlock Grid.Row="2"
                           Text="{x:Bind local:ReadingItemVisual.GetStickyPreviewText(QuickViewText, IsLock)}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           Margin="4, 4, 4, 0"/>
                <TextBlock Grid.Row="3"
                           Text="{x:Bind local:ReadingItemVisual.FormatTime(UpdateTime)}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="4, 4, 4, 0"/>
            </Grid>
        </DataTemplate>

        <!-- 模板选择器：便签走便签卡片，其余（阅读记录）走阅读卡片 -->
        <appui:FavoriteTemplateSelector x:Key="FavoriteTemplateSelector"
                                        ReadingTemplate="{StaticResource FavoriteReadingTemplate}"
                                        StickyTemplate="{StaticResource FavoriteStickyTemplate}"/>
    </Page.Resources>

    <Grid>
        <!-- 顶部标题栏：多选 / 视图切换（收藏内容来自资源库与便签本，打开入口收敛到卡片） -->
        <StackPanel Canvas.ZIndex="1" Orientation="Vertical" HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" Padding="24, 24, 24, 12"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="收藏夹" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="你所喜爱的，都在这里。" FontSize="12"
                               Opacity="0.6" Margin="0, 4, 0, 0"/>
                </StackPanel>
                <CommandBar Grid.Column="1" Background="Transparent" IsOpen="False"
                            DefaultLabelPosition="Right">
                    <AppBarButton x:Name="MultiSelectButton" Label="选择" Click="ToggleMultiSelectMode">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE762;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="切换视图">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8B3;"/>
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Tag="3" Text="每行 3 本" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="4" Text="每行 4 本" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="5" Text="每行 5 本" Click="ChangeViewColumns"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="auto" Padding="24, 108, 24, 0">
            <Grid Padding="0, 0, 0, 16">
                <!-- 空状态：无收藏内容时的初始布局 -->
                <Grid x:Name="EmptyPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Sources/Images/FavoriteCollection.png" MaxWidth="250" Stretch="Uniform"
                           Grid.Column="0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="40, 0, 0, 0"
                                Grid.Column="1">
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="这里空空如也，什么也没有。"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0, 8, 0, 0" Foreground="#9A9A9A" TextWrapping="Wrap"
                                   Text="在资源库中右键阅读记录、在便签本中右键便签并选择收藏，喜爱的内容将收纳在此处。"/>
                    </StackPanel>
                </Grid>

                <!-- 收藏列表：每行 3~5 本（可切换），多选取消收藏 / 删除 -->
                <GridView x:Name="FavoriteList" Background="Transparent"
                          Visibility="Collapsed" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="FavoriteList_ItemClick"
                          ItemContainerStyle="{StaticResource FavoriteGridViewItemStyle}"
                          ItemTemplateSelector="{StaticResource FavoriteTemplateSelector}"
                          SelectionChanged="FavoriteList_SelectionChanged"
                          SizeChanged="FavoriteList_SizeChanged">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" Margin="8, 0, 8, 8"
                                           HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>
        </ScrollViewer>

        <!-- 多选模式操作按钮：右下角悬浮取消收藏（Accent 强调色），仅多选且有选中项时显示 -->
        <Button x:Name="UnfavoriteSelectedButton" Click="UnfavoriteSelectedItems"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0, 0, 16, 16" Padding="18, 10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE734;" FontSize="16"/>
                <TextBlock Text="取消收藏" FontSize="14"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>
