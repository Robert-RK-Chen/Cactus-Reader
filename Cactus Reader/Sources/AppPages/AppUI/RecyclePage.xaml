<Page
    x:Class="Cactus_Reader.Sources.AppPages.AppUI.RecyclePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cactus_Reader.Sources.ToolKits"
    xmlns:entities="using:Cactus_Reader.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Page.Resources>
        <FontFamily x:Key="SegoeFluentIcons">/Sources/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons</FontFamily>

        <!-- 基于系统默认 GridViewItem 样式：内容横向撑满 ItemsWrapGrid 分配的列宽，
             多选勾选/选中高亮等视觉全部沿用系统默认（Win11 规范） -->
        <Style x:Key="RecycleGridViewItemStyle" TargetType="GridViewItem"
               BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 回收站卡片：矩形封面（类型图标）+ 名称 + 便签预览 + 删除时间；
             右键菜单：恢复 / 彻底删除（对话框警告） -->
        <DataTemplate x:Key="RecycleCardTemplate" x:DataType="entities:RecycleItem">
            <Grid Margin="8" RightTapped="RecycleCardRightTapped">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="恢复" Click="RestoreMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE777;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="彻底删除" Click="PurgeMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE74D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <!-- 封面缩略图：统一使用矩形色块 + 类型图标替代（固定高度，随列宽横向拉伸） -->
                <Border Grid.Row="0" Height="168" HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" CornerRadius="8"
                        Background="{x:Bind local:ReadingItemVisual.GetCoverBrush(ItemType)}">
                    <Grid>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}"
                                  Glyph="{x:Bind local:ReadingItemVisual.GetGlyph(ItemType)}"
                                  Foreground="White" FontSize="30"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="#40FFFFFF" CornerRadius="6" Padding="6, 2" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind local:ReadingItemVisual.GetTypeText(ItemType)}"
                                       FontSize="10" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           Margin="4, 8, 4, 0"/>
                <TextBlock Grid.Row="2"
                           Text="{x:Bind local:ReadingItemVisual.GetPreview(ItemType, Payload)}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           Margin="4, 4, 4, 0"/>
                <TextBlock Grid.Row="3"
                           Text="{x:Bind local:ReadingItemVisual.FormatTime(DeleteTime)}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="4, 4, 4, 0"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- 顶部标题栏：恢复 / 多选 / 视图切换 三个按钮（与资源库、便签本一致） -->
        <StackPanel Canvas.ZIndex="1" Orientation="Vertical" HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" Padding="24, 24, 24, 12"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="回收站" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="删除的内容会暂存于此。" FontSize="12"
                               Opacity="0.6" Margin="0, 4, 0, 0"/>
                </StackPanel>
                <CommandBar Grid.Column="1" Background="Transparent" IsOpen="False"
                            DefaultLabelPosition="Right">
                    <AppBarButton x:Name="RestoreButton" Label="恢复" IsEnabled="False"
                                  Click="RestoreSelectedItems">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE777;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="MultiSelectButton" Label="选择" Click="ToggleMultiSelectMode">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE762;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="切换视图">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8B3;"/>
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Tag="3" Text="每行 3 个" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="4" Text="每行 4 个" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="5" Text="每行 5 个" Click="ChangeViewColumns"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="auto" Padding="24, 108, 24, 0">
            <Grid Padding="0, 0, 0, 16">
                <!-- 空状态：回收站为空时的初始布局 -->
                <Grid x:Name="EmptyPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Sources/Images/NotesEmpty.png" MaxWidth="250" Stretch="Uniform"
                           Grid.Column="0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="40, 0, 0, 0"
                                Grid.Column="1">
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="这里空空如也，什么也没有。"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0, 8, 0, 0" Foreground="#9A9A9A" TextWrapping="Wrap"
                                   Text="被删除的便签和阅读记录会暂存于此，你可以随时恢复它们，或彻底删除以释放空间。"/>
                    </StackPanel>
                </Grid>

                <!-- 回收站列表：每行 3~5 个（可切换），左键单击选中，多选恢复 -->
                <GridView x:Name="RecycleGrid" Background="Transparent"
                          Visibility="Collapsed" SelectionMode="Single"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource RecycleGridViewItemStyle}"
                          ItemTemplate="{StaticResource RecycleCardTemplate}"
                          SelectionChanged="RecycleGrid_SelectionChanged"
                          SizeChanged="RecycleGrid_SizeChanged">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" Margin="8, 0, 8, 8"
                                           HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>
        </ScrollViewer>

        <!-- 多选模式彻底删除按钮：右下角悬浮（Accent 强调色），仅多选且有选中项时显示 -->
        <Button x:Name="DeleteSelectedButton" Click="DeleteSelectedItems"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0, 0, 16, 16" Padding="18, 10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE74D;" FontSize="16"/>
                <TextBlock Text="彻底删除" FontSize="14"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>
