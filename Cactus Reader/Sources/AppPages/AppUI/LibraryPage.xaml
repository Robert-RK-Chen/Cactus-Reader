<Page
    x:Class="Cactus_Reader.Sources.AppPages.AppUI.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cactus_Reader.Sources.ToolKits"
    xmlns:entities="using:Cactus_Reader.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Page.Resources>
        <FontFamily x:Key="SegoeFluentIcons">/Sources/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons</FontFamily>

        <!-- 基于系统默认 GridViewItem 样式：内容横向撑满 ItemsWrapGrid 分配的列宽，
             多选勾选/选中高亮等视觉全部沿用系统默认（Win11 规范） -->
        <Style x:Key="LibraryGridViewItemStyle" TargetType="GridViewItem"
               BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 阅读记录卡片：矩形封面（类型图标）+ 书名 + 类型标签 + 最后阅读时间；右键菜单：打开/分享/收藏/删除 -->
        <DataTemplate x:Key="LibraryBookCardTemplate" x:DataType="entities:ReadingItem">
            <Grid Margin="8" RightTapped="BookCardRightTapped">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="打开" Click="OpenReadingMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8E5;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="分享" Click="ShareReadingMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE72D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Tag="unfavorite" Text="取消收藏" Click="ToggleFavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE735;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Tag="favorite" Text="收藏" Click="ToggleFavoriteMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE734;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="删除" Click="DeleteReadingMenuClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE74D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <!-- 书本缩略图：统一使用矩形色块 + 类型图标替代（固定高度，随列宽横向拉伸） -->
                <Border x:Name="CoverBorder" Grid.Row="0" Height="168" HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" CornerRadius="8"
                        Background="{x:Bind local:ReadingItemVisual.GetCoverBrush(ItemType)}">
                    <Grid>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}"
                                  Glyph="{x:Bind local:ReadingItemVisual.GetGlyph(ItemType)}"
                                  Foreground="White" FontSize="30"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="#40FFFFFF" CornerRadius="6" Padding="6, 2" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind local:ReadingItemVisual.GetTypeText(ItemType)}"
                                       FontSize="10" Foreground="White"/>
                        </Border>
                        <!-- 收藏角标：已收藏时右上角显示金色星标 -->
                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE735;"
                                  Foreground="#FFC83D" FontSize="18"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                  Visibility="{x:Bind local:ReadingItemVisual.FavoriteVisibility(IsFavorite)}"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           Margin="4, 8, 4, 0"/>
                <TextBlock Grid.Row="2"
                           Text="{x:Bind local:ReadingItemVisual.FormatTime(UpdateTime)}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="4, 4, 4, 0"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- 顶部标题栏：有阅读记录后，"打开"入口收敛到右上角（与便签本一致） -->
        <StackPanel Canvas.ZIndex="1" Orientation="Vertical" HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" Padding="24, 24, 24, 12"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="资源库" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="所有资源，尽在一处。" FontSize="12"
                               Opacity="0.6" Margin="0, 4, 0, 0"/>
                </StackPanel>
                <CommandBar Grid.Column="1" Background="Transparent" IsOpen="False"
                            DefaultLabelPosition="Right">
                    <AppBarButton Label="打开">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8E5;"/>
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="打开文件" Click="OpenDocumentFile">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8E5;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="打开网络文档" Click="OpenWebDocument">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE774;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton x:Name="MultiSelectButton" Label="选择" Click="ToggleMultiSelectMode">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE762;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="切换视图">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8B3;"/>
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Tag="3" Text="每行 3 本" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="4" Text="每行 4 本" Click="ChangeViewColumns"/>
                                <MenuFlyoutItem Tag="5" Text="每行 5 本" Click="ChangeViewColumns"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="auto" Padding="24, 108, 24, 0">
            <Grid Padding="0, 0, 0, 16">
                <!-- 空状态：无任何阅读记录时的初始布局 -->
                <Grid x:Name="EmptyPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Sources/Images/LibraryEmpty.png" MaxWidth="250" Stretch="Uniform"
                           Grid.Column="0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="40, 0, 0, 0"
                                Grid.Column="1">
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="这里空空如也，什么也没有。"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0, 8, 0, 0" Foreground="#9A9A9A" TextWrapping="Wrap"
                                   Text="打开本地文档、EPUB 或网络文章，阅读记录将收纳在此处。"/>
                        <muxc:SplitButton x:Name="explorFileButton" Margin="0, 12, 0, 0" Height="36"
                                          Width="160" Click="OpenDocumentFile">
                            <muxc:SplitButton.Content>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE838;"
                                              FontSize="16"/>
                                    <TextBlock Text="浏览文件" Margin="12, 0, 0, 0" FontSize="14"/>
                                </StackPanel>
                            </muxc:SplitButton.Content>
                            <muxc:SplitButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Tag="openDocument" Text="打开文件" Width="200"
                                                    HorizontalAlignment="Left" Height="40" Click="OpenDocumentFile">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE8E5;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Tag="openFromInternet" Text="打开网络文档" Width="200"
                                                    Click="OpenWebDocument" HorizontalAlignment="Left" Height="40">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE774;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </muxc:SplitButton.Flyout>
                        </muxc:SplitButton>
                    </StackPanel>
                </Grid>

                <!-- 阅读记录列表：每行 3~5 本（可切换），多选删除 -->
                <GridView x:Name="LibraryBookList" x:FieldModifier="Public" Background="Transparent"
                          Visibility="Collapsed" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="LibraryBookList_ItemClick"
                          ItemContainerStyle="{StaticResource LibraryGridViewItemStyle}"
                          ItemTemplate="{StaticResource LibraryBookCardTemplate}"
                          SelectionChanged="LibraryBookList_SelectionChanged"
                          SizeChanged="LibraryBookList_SizeChanged">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" Margin="8, 0, 8, 8"
                                           HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>
        </ScrollViewer>

        <!-- 多选模式删除按钮：右下角悬浮（Accent 强调色），仅多选且有选中项时显示 -->
        <Button x:Name="DeleteSelectedButton" Click="DeleteSelectedBooks"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0, 0, 16, 16" Padding="18, 10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE74D;" FontSize="16"/>
                <TextBlock Text="删除" FontSize="14"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>
