<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:stickynotes="using:Cactus_Reader.Sources.StickyNotes">
    <FontFamily x:Key="MiSans">/Sources/Fonts/MiSans/MiSans-Regular.ttf#MiSans</FontFamily>
    <FontFamily x:Key="MiSansBold">/Sources/Fonts/MiSans/MiSans-Bold.ttf#MiSans Bold</FontFamily>
    <FontFamily x:Key="SegoeFluentIcons">/Sources/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons</FontFamily>

    <Style TargetType="stickynotes:StickyQuickView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="stickynotes:StickyQuickView">
                    <!-- 事件统一在 OnApplyTemplate 中绑定（Root），此处不声明事件避免双重触发 -->
                    <Grid x:Name="Root" CornerRadius="4" Background="{TemplateBinding ViewBackground}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                          Tag="{TemplateBinding ThemeKind}" HorizontalAlignment="Stretch">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="OpenSticky" Text="打开便签">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE890;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ShareSticky" Text="分享便签">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE72D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="UnfavoriteSticky" Text="取消收藏" Visibility="Collapsed">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE735;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="FavoriteSticky" Text="收藏" Visibility="Visible">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE734;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="LockSticky" Text="锁定便签" Visibility="Visible">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE72E;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="UnlockSticky" Text="解锁便签" Visibility="Collapsed">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xe785;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="DeleteSticky" Text="删除便签">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE74D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="68"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{TemplateBinding TitleBackground}"
                              CornerRadius="4, 4, 0, 0"/>
                        <Grid Grid.Row="1">
                            <TextBlock TextTrimming="CharacterEllipsis" FontSize="13"
                                       FontWeight="Bold" FontFamily="{StaticResource MiSans}" Padding="12, 8, 12, 8"
                                       Text="{TemplateBinding CreateTimeText}" Foreground="Black"/>
                            <!-- 收藏星标：已收藏时右上角显示金色星标 -->
                            <FontIcon FontFamily="{StaticResource SegoeFluentIcons}" Glyph="&#xE735;"
                                      Foreground="#FFC83D" FontSize="16" Margin="0, 6, 10, 0"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Visibility="{TemplateBinding FavoriteStarVisibility}"/>
                        </Grid>
                        <!-- 固定高度：行 2 恒为 68px（文字区 60px = 3 行 × 行高 20 + 底部 padding 8），
                             内容不足或超出均不改变组件高度，超出部分裁剪省略 -->
                        <TextBlock x:Name="PreviewText" Grid.Row="2" TextWrapping="Wrap" FontSize="14" Padding="12, 0, 12, 8"
                                   FontFamily="{StaticResource MiSans}" LineHeight="20" FontWeight="Medium"
                                   Text="{TemplateBinding QuickViewText}" Foreground="Black"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
